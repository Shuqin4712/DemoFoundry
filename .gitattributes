# Text files are stored and checked out with LF on every platform,
# so regenerated output can be compared byte for byte.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.m4a binary
*.aac binary
*.ogg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
